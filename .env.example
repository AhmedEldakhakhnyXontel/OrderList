# Every environment variable the app and tests read. Copy to .env.local, or pull
# the real values from EAS: npx eas-cli@latest env:pull --environment development
# Never commit real values; EXPO_PUBLIC_ variables are inlined into the app bundle.

# Firebase web config (public by design), used by src/data/app-data.ts
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firestore emulator address for the Jest tests. `npm test` sets it through
# firebase emulators:exec; the tests fall back to 127.0.0.1:8080 when unset.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
